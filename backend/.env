# Application
APP_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database - SQLite (no server needed)
DATABASE_URL=sqlite+aiosqlite:///./earthquake.db
SYNC_DATABASE_URL=sqlite:///./earthquake.db

# Redis (disabled by default - enable only if you have Redis installed)
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_WAVEFORM=300
REDIS_TTL_PREDICTION=60

# FDSN / IRIS
IRIS_FDSN_URL=https://service.iris.edu/fdsnws/event/1/
IRIS_STATION_URL=https://service.iris.edu/fdsnws/station/1/
IRIS_DATASELECT_URL=https://service.iris.edu/fdsnws/dataselect/1/

# USGS
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/

# Model
MODEL_DIR=earthquake_service/models/saved/
CNN_LSTM_MODEL=cnn_lstm_model.pt
XGBOOST_MODEL=xgb_classifier.json
SCALER_FILE=feature_scaler.pkl

# Model metadata
MODEL_VERSION=1.0.0
MODEL_NAME=cnn_lstm_xgb

# Prediction thresholds
HIGH_RISK_THRESHOLD=0.70
MEDIUM_RISK_THRESHOLD=0.40

# Logging
LOG_LEVEL=INFO