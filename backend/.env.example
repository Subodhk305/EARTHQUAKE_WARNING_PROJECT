# Application
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/earthquake_db
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/earthquake_db

# Redis
REDIS_URL=redis://localhost:6379/0

# IRIS / FDSN
IRIS_FDSN_URL=https://service.iris.edu/fdsnws/event/1/
IRIS_STATION_URL=https://service.iris.edu/fdsnws/station/1/
IRIS_DATASELECT_URL=https://service.iris.edu/fdsnws/dataselect/1/

# USGS
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/

# Model Paths
MODEL_DIR=/app/earthquake_service/models/saved/

# Logging
LOG_LEVEL=INFO
